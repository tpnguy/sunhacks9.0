# Copy to server/.env for local dev (never commit .env). On EC2 these come from SSM Parameter Store.
# Real environment variables always win over values in .env.

PORT=8080
# Empty → MOCK mode (fake scores + canned roasts). Paid-tier key only (player audio must not be used for training).
GEMINI_API_KEY=
# Current stable Gemini Flash model (https://aistudio.google.com/docs/models)
GEMINI_MODEL=gemini-4-hydrogen
# Used for the retry when the primary model errors or times out
GEMINI_FALLBACK_MODEL=gemini-3.5-flash
AWS_REGION=us-west-2
TAKES_TABLE=dubstudio-takes
CLIPS_TABLE=dubstudio-clips
# Empty → S3 features disabled (upload_url is "")
MEDIA_BUCKET=
PUBLIC_BASE_URL=http://localhost:8080
# dynamo | memory
STORE=memory
CLIPS_FILE=../clips/clips.json

# --- optional tunables (defaults shown) ---
# PLAYERS_TABLE=dubstudio-players
# GEMINI_TIMEOUT_SECONDS=15      # per attempt; 1 retry
# GEMINI_THINKING_LEVEL=low      # low|medium|high; empty = model default
# MAX_UPLOAD_BYTES=5242880       # POST /takes body limit
# ENV_FILE=.env
